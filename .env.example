GOOGLE_API_KEY=your_google_api_key
GROQ_API_KEY=your_groq_api_key

# Resume parsing through LiteLLM
RESUME_PRIMARY_MODEL=gemini/gemini-3.5-flash
RESUME_PRIMARY_API_BASE=
RESUME_PRIMARY_API_KEY_ENV=GOOGLE_API_KEY
RESUME_FALLBACK_MODEL=
RESUME_FALLBACK_API_BASE=
RESUME_FALLBACK_API_KEY_ENV=
RESUME_MODEL_TIMEOUT_SECONDS=

# Question generation through LiteLLM
QUESTION_GENERATION_PRIMARY_MODEL=gemini/gemini-3.1-flash-lite
QUESTION_GENERATION_PRIMARY_API_BASE=
QUESTION_GENERATION_PRIMARY_API_KEY_ENV=GOOGLE_API_KEY
QUESTION_GENERATION_FALLBACK_MODEL=
QUESTION_GENERATION_FALLBACK_API_BASE=
QUESTION_GENERATION_FALLBACK_API_KEY_ENV=
QUESTION_GENERATION_MODEL_TIMEOUT_SECONDS=

# Answer analysis through LiteLLM
ANSWER_ANALYSIS_PRIMARY_MODEL=gemini/gemini-3.1-flash-lite
ANSWER_ANALYSIS_PRIMARY_API_BASE=
ANSWER_ANALYSIS_PRIMARY_API_KEY_ENV=GOOGLE_API_KEY
ANSWER_ANALYSIS_FALLBACK_MODEL=
ANSWER_ANALYSIS_FALLBACK_API_BASE=
ANSWER_ANALYSIS_FALLBACK_API_KEY_ENV=
ANSWER_ANALYSIS_MODEL_TIMEOUT_SECONDS=

# Speech to text through LiteLLM
SPEECH_TO_TEXT_PRIMARY_MODEL=groq/whisper-large-v3-turbo
SPEECH_TO_TEXT_PRIMARY_API_BASE=
SPEECH_TO_TEXT_PRIMARY_API_KEY_ENV=GROQ_API_KEY
SPEECH_TO_TEXT_PRIMARY_REQUEST_MODE=transcription
SPEECH_TO_TEXT_FALLBACK_MODEL=gemini/gemini-3.1-flash-lite
SPEECH_TO_TEXT_FALLBACK_API_BASE=
SPEECH_TO_TEXT_FALLBACK_API_KEY_ENV=GOOGLE_API_KEY
SPEECH_TO_TEXT_FALLBACK_REQUEST_MODE=completion
SPEECH_TO_TEXT_MODEL_TIMEOUT_SECONDS=

# Text to speech through LiteLLM
TEXT_TO_SPEECH_PRIMARY_MODEL=groq/canopylabs/orpheus-v1-english
TEXT_TO_SPEECH_PRIMARY_API_BASE=
TEXT_TO_SPEECH_PRIMARY_API_KEY_ENV=GROQ_API_KEY
TEXT_TO_SPEECH_PRIMARY_VOICE=troy
TEXT_TO_SPEECH_PRIMARY_RESPONSE_FORMAT=wav
TEXT_TO_SPEECH_PRIMARY_MAX_CHARACTERS=200
TEXT_TO_SPEECH_FALLBACK_MODEL=gemini/gemini-3.1-flash-tts-preview
TEXT_TO_SPEECH_FALLBACK_API_BASE=
TEXT_TO_SPEECH_FALLBACK_API_KEY_ENV=GOOGLE_API_KEY
TEXT_TO_SPEECH_FALLBACK_VOICE=Kore
TEXT_TO_SPEECH_FALLBACK_RESPONSE_FORMAT=
TEXT_TO_SPEECH_MODEL_TIMEOUT_SECONDS=

# Pydantic Logfire
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=intervai-api
LOGFIRE_ENVIRONMENT=development
LOGFIRE_SEND_TO_LOGFIRE=if-token-present

# Optional comma-separated regular expressions for routes to exclude.
LOGFIRE_EXCLUDED_URLS=
