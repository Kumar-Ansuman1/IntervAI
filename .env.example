GOOGLE_API_KEY=your_google_api_key

# Resume parsing through LiteLLM
RESUME_PRIMARY_MODEL=gemini/gemini-3.5-flash
RESUME_PRIMARY_API_BASE=
RESUME_PRIMARY_API_KEY_ENV=GOOGLE_API_KEY
RESUME_FALLBACK_MODEL=
RESUME_FALLBACK_API_BASE=
RESUME_FALLBACK_API_KEY_ENV=
RESUME_MODEL_TIMEOUT_SECONDS=

# Question generation through LiteLLM
QUESTION_GENERATION_PRIMARY_MODEL=gemini/gemini-3.1-flash-lite
QUESTION_GENERATION_PRIMARY_API_BASE=
QUESTION_GENERATION_PRIMARY_API_KEY_ENV=GOOGLE_API_KEY
QUESTION_GENERATION_FALLBACK_MODEL=
QUESTION_GENERATION_FALLBACK_API_BASE=
QUESTION_GENERATION_FALLBACK_API_KEY_ENV=
QUESTION_GENERATION_MODEL_TIMEOUT_SECONDS=

# Pydantic Logfire
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=intervai-api
LOGFIRE_ENVIRONMENT=development
LOGFIRE_SEND_TO_LOGFIRE=if-token-present

# Optional comma-separated regular expressions for routes to exclude.
LOGFIRE_EXCLUDED_URLS=

